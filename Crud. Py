 print("Enter Database and Table name to create")
 database = input("Enter Database Name: ")
 table = input("Enter Table Name: ")
 #create Database & Table
 db = CRUD(host, user, password, database, table, use_pure)
 
 #insert data
 print("Insert Data\n")
 name = input("Enter name: ")
 age = int(input("Enter age: "))
 db.insertDATA(name,age)
 #show data
 print("\nAll Data\n")
 db.showDATA()
 #update data
 print("\nUpdate Data\n")
 eid = int(input("Enter id to update Data: "))
 name = input("Update name: ")
 age = int(input("Update age: "))
 db.updateDATA(eid,name,age)
 #delete data
 print("\nDelete Data\n")
 eid = int(input("Enter id to delete Data: "))
 db.deleteDATA(eid)
